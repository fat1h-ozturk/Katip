#!/usr/bin/env bash
# Launcher script for Katip

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON="$DIR/.venv/bin/python"
else
    PYTHON="python3"
fi

if [ -f "/usr/lib64/libgtk4-layer-shell.so.0" ]; then
    export LD_PRELOAD="/usr/lib64/libgtk4-layer-shell.so.0${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$PYTHON" -m katip "$@"
